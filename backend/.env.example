# Copy to backend/.env for local development (it is git-ignored).
# In production these are set on the Cloud Run service — never commit real values.

# ── AI providers (at least one required; Gemini is tried first) ─────────────
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Firebase (used only to verify users' ID tokens) ─────────────────────────
FIREBASE_PROJECT_ID=studymate-e4ecb
# No service account is needed just to verify tokens. If you ever need one:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── YouTube (optional) ──────────────────────────────────────────────────────
# Without a key, video titles/thumbnails come from YouTube oEmbed and chapters
# are unavailable. Transcripts don't need a key.
YOUTUBE_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
# Extra CORS origins (comma-separated). Not needed when using the Vite proxy
# or the single-container deploy.
ALLOWED_ORIGINS=
# Per-user limits on AI requests
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_BURST=10
